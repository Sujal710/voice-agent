# ---------- App ----------
ENVIRONMENT=development
LOG_LEVEL=INFO
COMPANY_NAME=Acme Solutions
AGENT_NAME=Riya
# Public HTTPS URL Twilio can reach (ngrok in development), no trailing slash
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app
# For scripts / curl only (X-API-Key header). Never put it in a web page.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
API_KEY=replace-with-a-long-random-string

# ---------- Call Desk sign-in ----------
# Run: python -m scripts.hash_password   and paste the two lines it prints here
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD_HASH=
SESSION_SECRET=
SESSION_HOURS=12
COOKIE_SECURE=true

# ---------- MongoDB ----------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=voice_sales_agent

# ---------- Twilio ----------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15551234567
TWILIO_VALIDATE_SIGNATURE=true
MAX_CALL_DURATION_S=600

# ---------- Sarvam (STT + TTS) ----------
SARVAM_API_KEY=your_sarvam_api_key
STT_MODEL=saaras:v4
STT_LANGUAGE_CODE=auto
STT_MODE=transcribe
STT_STREAM_TYPE=fast
STT_VAD_THRESHOLD=0.3
STT_SILENCE_DURATION_MS=500
STT_MIN_SPEECH_DURATION_MS=250
STT_MIN_LANGUAGE_CONFIDENCE=0.6
# JSON list of words to bias recognition (saaras:v4 only)
STT_KEYTERMS=["Acme","SolarMax","EMI"]

TTS_MODEL=bulbul:v3
TTS_SPEAKER=shubh
TTS_PACE=1.05
TTS_TEMPERATURE=0.6

# ---------- Groq ----------
GROQ_API_KEY=your_groq_api_key
GROQ_AGENT_MODEL=llama-3.3-70b-versatile
GROQ_TRANSLATE_MODEL=llama-3.1-8b-instant
LLM_MAX_TOKENS=220
LLM_TEMPERATURE=0.3

# ---------- Memory ----------
MEMORY_MAX_RECENT_TOKENS=1200
MEMORY_PAST_CALLS=3

# ---------- Daily CSV calling ----------
MAX_CONCURRENT_OUTBOUND_CALLS=10
DIALER_ENABLED=true
CALLING_TIMEZONE=Asia/Kolkata
CALLING_HOURS_START=09:00
CALLING_HOURS_END=21:00
DEFAULT_COUNTRY_CODE=91
DEFAULT_LANGUAGE=en-IN
